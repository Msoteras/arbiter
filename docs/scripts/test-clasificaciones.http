### 5. Escenario Requiere Análisis Manual: Información contradictoria
POST {{endpoint}}
Content-Type: application/json

{
  "ramo": "Celulares",
  "producto": "Celular Protegido Premium",
  "hechoGenerador": "Robo en vía pública",
  "bienAsegurado": "Samsung Galaxy S24 Ultra - IMEI 353000000000055",
  "aseguradoDni": "40.777.111",
  "polizaNumero": "POL-2026-040",
  "descripcionLibre": "El celular desapareció pero no sé si me lo robaron o lo perdí. Estaba en el colectivo. Es raro porque no me lo quitaron de la mano pero tampoco lo vi en la estación siguiente. La denuncia policial dice que fue robo pero yo dije que no sabía bien qué pasó.",
  "fechaHecho": "2026-06-12T18:30:00",
  "lugarHecho": "Colectivo línea 159, CABA",
  "adjuntosOCR": [
    "DENUNCIA POLICIAL Nro 2026/85432\nFecha: 12/06/2026 19:00 hs\nDenunciante reporta ROBO pero sin detalles claros del suceso."
  ]
}

> {%
  client.test("request", function() {
    client.assert(response.status === 200, "Status debe ser 200");
  });
%}
