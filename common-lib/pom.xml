<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ar.edu.utn.frba.arbiter</groupId>
        <artifactId>arbiter</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-lib</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Bean Validation annotations used by shared request DTOs (e.g. ClaimReport). -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- JPA for the common-schema entities (common/models/entities): the arbiter_common
             tables belong to the platform, not to one module, so they are defined once here.
             Optional on purpose, same reasoning as the security deps below — a module that
             doesn't touch the common schema shouldn't get JPA dragged onto its classpath.
             Each module that maps these entities re-declares spring-boot-starter-data-jpa
             and adds ar.edu.utn.frba.arbiter.common.models.entities to its @EntityScan. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Filtro de validación de JWT compartido entre módulos (H0003 - RBAC). Todas `optional`:
             common-lib no puede imponerle Spring Security a un módulo que no lo pida (rompería
             classification-service, que depende de common-lib pero no protege sus endpoints
             todavía) — cada módulo que use JwtAuthenticationFilter las vuelve a declarar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- SendGrid SDK for SendGridAdapter (transactional mail: invites, password resets,
             notifications). Optional: each module using the adapter re-declares it, same
             approach as jjwt above. -->
        <dependency>
            <groupId>com.sendgrid</groupId>
            <artifactId>sendgrid-java</artifactId>
            <version>4.10.3</version>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>