# =============================================================================
# Arbiter — variables de entorno para correr local contra una BD remota (Railway)
#
# Copiá este archivo a `.env` y completá los valores. `.env` está gitignoreado:
# NUNCA pongas credenciales reales acá ni las commitees.
#
#   cp .env.example .env
#
# Después:  .\scripts\run-local.ps1 cases-service
# =============================================================================

# ─── Base de datos ───────────────────────────────────────────────────────────
# Railway te da DATABASE_PUBLIC_URL con este formato:
#
#   postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE
#
# Spring necesita las tres partes por separado, y el prefijo `jdbc:`. O sea que
# de esa URL sacás:
#
#   DB_URL      = jdbc:postgresql://HOST:PUERTO/BASE?sslmode=require
#   DB_USER     = USUARIO
#   DB_PASSWORD = PASSWORD
#
# Usá DATABASE_PUBLIC_URL y no DATABASE_URL: el segundo apunta a
# *.railway.internal, que sólo resuelve dentro de la red de Railway.
#
# sslmode=require: Railway exige TLS para conexiones desde afuera.
DB_URL=jdbc:postgresql://HOST:PUERTO/railway?sslmode=require
DB_USER=postgres
DB_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Mínimo 32 bytes (HS256). Tiene que ser EL MISMO en los 5 módulos: cada uno
# valida los tokens que emite auth-service. Generá uno propio con:
#
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# ─── Comunicación entre módulos ──────────────────────────────────────────────
CLASSIFICATION_SERVICE_URL=http://localhost:8082
RULES_SERVICE_URL=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:4200

# Puerto donde docker-compose publica el frontend containerizado. 4200, igual que `ng serve` y
# que FRONTEND_BASE_URL de arriba: es el puerto del frontend en todo el equipo.
#
# Por eso mismo NO corras `ng serve` y el contenedor a la vez: `ng serve` toma [::1]:4200 y le
# gana a Docker cuando el navegador resuelve `localhost` (IPv6 primero en Windows), así que
# verías el dev server creyendo que mirás el contenedor. Si alguna vez los necesitás juntos,
# cambiá ESTE valor y dejale el 4200 al `ng serve`.
FRONTEND_PORT=4200

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Auth0 es el único proveedor de login: sin estas 5 variables auth-service no arranca.
AUTH_PROVIDER=auth0
AUTH0_DOMAIN=
AUTH0_LOGIN_CLIENT_ID=
AUTH0_LOGIN_CLIENT_SECRET=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Clave RSA (PKCS#8, base64) con la que el front cifra la contraseña antes del login.
# Vacía, auth-service genera una al arrancar: alcanza para una sola instancia local, pero con
# más de una cada instancia tendría la suya y los logins fallarían salteado.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
PASSWORD_ENCRYPTION_PRIVATE_KEY=

# ─── SendGrid (mails de invitación y de cambio de estado) ────────────────────
# Sin API key el adapter no manda nada; el resto del flujo funciona igual.
SENDGRID_API_KEY=
SENDGRID_FROM_ADDRESS=no-reply@arbiter.test
SENDGRID_FROM_NAME=Arbiter

# ─── Quién sirve el modelo ───────────────────────────────────────────────────
# Las dos líneas de abajo SOLO hacen falta para levantar con `docker compose up` a
# mano. Si usás los scripts, no toques nada acá: cada uno fija su proveedor y su
# perfil, y pisa lo que diga este archivo.
#
#   .\scripts\dev-ollama.ps1   → modelo propio, corriendo acá al lado
#   .\scripts\dev-gemini.ps1   → Gemini por Vertex, sin modelo local
#
# `ollama` (default) o `gemini` (ver el bloque de Vertex más abajo).
LLM_PROVIDER=ollama

# El contenedor del modelo está detrás de un perfil de compose, así que sin esta línea
# `docker compose up` levanta todo menos Ollama, y la clasificación falla recién al
# primer siniestro con "Connection refused". Con `gemini` se deja comentada y se
# ahorran ~11 GB de RAM.
COMPOSE_PROFILES=ollama

# ─── Ollama (clasificación) ──────────────────────────────────────────────────
# Local, no va a Railway. Si no lo tenés prendido, la clasificación falla y el
# expediente queda en PENDING_CLASSIFICATION hasta agotar reintentos.
OLLAMA_BASE_URL=http://localhost:11434
# La variante -instruct: el tag pelado resuelve a la "thinking", que razona antes de responder
# y agota el presupuesto de tokens sin devolver nada.
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_NUM_CTX=32768

# ─── Gemini por Vertex (alternativa a Ollama) ────────────────────────────────
# Solo se usa con LLM_PROVIDER=gemini. No hay API key: el SDK autentica por ADC
# (`gcloud auth application-default login`); `scripts\dev-gemini.ps1` resuelve la
# credencial y la monta en el contenedor vía docker-compose.gemini.yml.
# `global` y no una región: los Gemini 3 solo se sirven desde el endpoint global.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# ─── Análisis de imágenes (opcional, apagado por defecto) ────────────────────
EMBEDDING_SERVICE_URL=http://localhost:8000
GOOGLE_VISION_ENABLED=false
GOOGLE_VISION_API_KEY=

LOG_LEVEL=INFO
