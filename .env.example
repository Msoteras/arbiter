# =============================================================================
# Arbiter — variables de entorno para correr local contra una BD remota (Railway)
#
# Copiá este archivo a `.env` y completá los valores. `.env` está gitignoreado:
# NUNCA pongas credenciales reales acá ni las commitees.
#
#   cp .env.example .env
#
# Después:  .\scripts\run-local.ps1 cases-service
# =============================================================================

# ─── Base de datos ───────────────────────────────────────────────────────────
# Railway te da DATABASE_PUBLIC_URL con este formato:
#
#   postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE
#
# Spring necesita las tres partes por separado, y el prefijo `jdbc:`. O sea que
# de esa URL sacás:
#
#   DB_URL      = jdbc:postgresql://HOST:PUERTO/BASE?sslmode=require
#   DB_USER     = USUARIO
#   DB_PASSWORD = PASSWORD
#
# Usá DATABASE_PUBLIC_URL y no DATABASE_URL: el segundo apunta a
# *.railway.internal, que sólo resuelve dentro de la red de Railway.
#
# sslmode=require: Railway exige TLS para conexiones desde afuera.
DB_URL=jdbc:postgresql://HOST:PUERTO/railway?sslmode=require
DB_USER=postgres
DB_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Mínimo 32 bytes (HS256). Tiene que ser EL MISMO en los 5 módulos: cada uno
# valida los tokens que emite auth-service. Generá uno propio con:
#
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# ─── Comunicación entre módulos ──────────────────────────────────────────────
CLASSIFICATION_SERVICE_URL=http://localhost:8082
FRONTEND_BASE_URL=http://localhost:4200

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# AUTH_PROVIDER=auth0 usa Auth0 de verdad y necesita las 5 variables de abajo.
# Para probar sin Auth0, poné `database` (BCrypt local) — pero ojo: el esquema
# multi-tenant ya no tiene password_hash, así que ese camino no funciona hoy.
AUTH_PROVIDER=auth0
AUTH0_DOMAIN=
AUTH0_LOGIN_CLIENT_ID=
AUTH0_LOGIN_CLIENT_SECRET=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# ─── SendGrid (mails de invitación y de cambio de estado) ────────────────────
# Sin API key el adapter no manda nada; el resto del flujo funciona igual.
SENDGRID_API_KEY=
SENDGRID_FROM_ADDRESS=no-reply@arbiter.test
SENDGRID_FROM_NAME=Arbiter

# ─── Quién sirve el modelo ───────────────────────────────────────────────────
# `ollama` (default) = modelo propio, corriendo acá al lado.
# `gemini`           = Gemini por Vertex, sin modelo local (ver más abajo).
LLM_PROVIDER=ollama

# Con LLM_PROVIDER=ollama hace falta ESTA línea: el contenedor del modelo está
# detrás de un perfil de compose, así que sin ella `docker compose up` levanta todo
# menos Ollama, y la clasificación falla recién al primer siniestro con
# "Connection refused". Con `gemini` se deja comentada y se ahorran ~11 GB de RAM.
COMPOSE_PROFILES=ollama

# ─── Ollama (clasificación) ──────────────────────────────────────────────────
# Local, no va a Railway. Si no lo tenés prendido, la clasificación falla y el
# expediente queda en PENDING_CLASSIFICATION hasta agotar reintentos.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl
OLLAMA_NUM_CTX=32768

# ─── Gemini por Vertex (alternativa a Ollama) ────────────────────────────────
# Solo se usa con LLM_PROVIDER=gemini. No hay API key: el SDK autentica por ADC
# (`gcloud auth application-default login`), y el archivo de credencial se monta
# en el contenedor desde tu docker-compose.override.yml — ver el ejemplo comentado
# en docker-compose.yml, en el bloque de classification-service.
# `global` y no una región: los Gemini 3 solo se sirven desde el endpoint global.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# ─── Análisis de imágenes (opcional, apagado por defecto) ────────────────────
EMBEDDING_ENABLED=false
EMBEDDING_SERVICE_URL=http://localhost:8000
GOOGLE_VISION_ENABLED=false
GOOGLE_VISION_API_KEY=

LOG_LEVEL=INFO
