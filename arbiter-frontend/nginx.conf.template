# Rendered by envsubst; only the names in NGINX_ENVSUBST_FILTER (Dockerfile) are substituted.
#
# Production counterpart of proxy.conf.json. KEEP THEM IN SYNC: a route missing here works in
# development and 404s once deployed.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Required by the `set`-then-proxy_pass pattern below.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Matches cases-service's 30MB request limit; nginx's 1m default would 413 an ordinary photo.
    client_max_body_size 30m;

    # The upload that triggers the LLM classification can outlast the default 60s read timeout.
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ─── API ────────────────────────────────────────────────────────────────────────────
    # Longest prefix wins, so /claims and /claim-causes route correctly regardless of order.
    #
    # `set` + a variable in proxy_pass is deliberate: with a literal hostname nginx refuses to boot
    # if a backend doesn't resolve. A variable defers resolution to request time, so a missing
    # backend is a 502 on its own routes only. With a variable, $request_uri must be appended.

    location /api/v1/auth {
        set $upstream ${AUTH_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    # WebSocket upgrade: HTTP/1.1 comes from the include; the long timeouts keep idle sockets open.
    location /api/v1/ws {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/v1/cases {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/claim-causes {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/coverages {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/settlement-authorities {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/policies {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/notifications {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/expert-firms {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/rules {
        set $upstream ${RULES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    # The only classification-service route the browser needs; the rest is module-to-module only
    # and deliberately not exposed.
    location /api/v1/claims {
        set $upstream ${CLASSIFICATION_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/reports {
        set $upstream ${REPORTS_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    # ─── SPA ────────────────────────────────────────────────────────────────────────────
    # Hashed filenames can be cached hard; index.html must not be, or deploys stay invisible.
    location ~ \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
