# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only the ${...} names listed in NGINX_ENVSUBST_FILTER (see Dockerfile) are substituted;
# nginx's own $uri / $host / $request_uri survive untouched.
#
# This is the production counterpart of arbiter-frontend/proxy.conf.json, which does the same
# routing for `ng serve`. THE TWO HAVE TO STAY IN SYNC: a route added there and forgotten here
# works all through development and 404s the moment it is deployed.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Filled in by the image's 15-local-resolvers.envsh from /etc/resolv.conf (enabled via
    # NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile), so no resolver address is hardcoded.
    # Required by the `set`-then-proxy_pass pattern below.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # cases-service accepts 10MB per file and 30MB per request (see its application.yml).
    # nginx's default is 1m, which would reject any ordinary phone photo with a 413 long before
    # the request ever reached the backend.
    client_max_body_size 30m;

    # The LLM classification is triggered asynchronously, but the upload that kicks it off still
    # travels through here, and Gemini/Ollama round trips are slow enough that the default 60s
    # read timeout is a real risk.
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ─── API ────────────────────────────────────────────────────────────────────────────
    # Longest-prefix wins in nginx, so /api/v1/claims and /api/v1/claim-causes resolve to
    # different services correctly regardless of the order they appear in here.
    #
    # Every upstream goes through `set` + a variable in proxy_pass, which is NOT a style choice:
    # with a literal hostname nginx resolves it once at startup and REFUSES TO BOOT if it does
    # not resolve — so the frontend would crash-loop whenever it starts before the backends
    # exist, or while any one of them is down. A variable defers resolution to request time, so
    # a missing backend degrades to a 502 on its own routes instead of taking the whole SPA
    # down, and `valid=10s` above means a redeployed backend is picked up without a restart.
    # $request_uri has to be appended explicitly: with a variable, nginx no longer passes the
    # matched URI through on its own.

    location /api/v1/auth {
        set $upstream ${AUTH_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/cases {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/claim-causes {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/coverages {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/policies {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/notifications {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/expert-firms {
        set $upstream ${CASES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    location /api/v1/rules {
        set $upstream ${RULES_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    # classification-service is otherwise module-to-module only (cases-service calls it), so
    # /claims is the one classification route the browser ever needs. /classifications,
    # /fraud-records and /image-embeddings are deliberately NOT exposed here.
    location /api/v1/claims {
        set $upstream ${CLASSIFICATION_SERVICE_URL};
        proxy_pass $upstream$request_uri;
        include /etc/nginx/arbiter-proxy-headers.conf;
    }

    # ─── SPA ────────────────────────────────────────────────────────────────────────────
    # Hashed filenames, so they can be cached hard. index.html must NOT be, or a deploy stays
    # invisible until the browser decides to revalidate.
    location ~ \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
